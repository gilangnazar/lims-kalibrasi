PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lims_kalibrasi

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=8h

# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Password for the "admin" user created by `npm run seed`
SEED_ADMIN_PASSWORD=

# Folder for uploaded files (relative to api/). Keep it outside any web root and back it up.
UPLOAD_DIR=uploads
